    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "fastify": "^4.28.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "postgres": "^3.4.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3",
