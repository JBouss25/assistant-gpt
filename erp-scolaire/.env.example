# ─── Databases ───────────────────────────────────────────
CORE_ADMIN_DB_USER=erpadmin

CORE_ADMIN_DB_PASSWORD=change_me_strong_password

TIMETABLE_DB_USER=erptime
TIMETABLE_DB_PASSWORD=change_me_strong_password

ATTENDANCE_DB_USER=erpattend
ATTENDANCE_DB_PASSWORD=change_me_strong_password

FINANCE_DB_USER=erpfinance
FINANCE_DB_PASSWORD=change_me_strong_password

GRADEBOOK_DB_USER=erpgrades
GRADEBOOK_DB_PASSWORD=change_me_strong_password

LMS_DB_USER=erplms
LMS_DB_PASSWORD=change_me_strong_password

NOTIF_DB_USER=erpnotif
NOTIF_DB_PASSWORD=change_me_strong_password

AI_DB_USER=erpai
AI_DB_PASSWORD=change_me_strong_password

CHATBOT_DB_USER=erpchat
CHATBOT_DB_PASSWORD=change_me_strong_password

ANALYTICS_DB_USER=erpanalytics
ANALYTICS_DB_PASSWORD=change_me_strong_password

# ─── Paiement CMI Maroc ───────────────────────────────────
CMI_CLIENT_ID=your_cmi_client_id
CMI_STORE_KEY=your_cmi_store_key
CMI_BASE_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# ─── Stripe (paiements internationaux) ───────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── S3 / Stockage bulletins ─────────────────────────────
S3_BUCKET_BULLETINS=erp-bulletins
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# ─── App ─────────────────────────────────────────────────
APP_BASE_URL=https://erp.ma

KC_DB_USER=kcadmin
KC_DB_PASSWORD=change_me_strong_password

# ─── Keycloak ────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change_me_strong_password

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_password

# ─── Encryption (32 bytes hex) ───────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change_me_64_char_hex_string_here

# ─── QR Code HMAC Secret ─────────────────────────────────
# Generate: openssl rand -hex 32
QR_HMAC_SECRET=change_me_64_char_hex_string_here

# ─── S3 LMS (cours, devoirs) ─────────────────────────────
S3_BUCKET=erp-scolaire-lms
S3_REGION=eu-west-3
# S3_ENDPOINT=  # Pour MinIO/OVH — laisser vide pour AWS natif

# ─── WhatsApp Business (Meta Cloud API) ──────────────────
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_bearer_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_secret

# ─── Firebase Cloud Messaging (Push) ─────────────────────
# Contenu JSON du service account Firebase (minifié sur une ligne)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Email (SendGrid ou SMTP) ────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=noreply@erp-scolaire.ma
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# ─── SMS (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+12125550000

# ─── Allowed Origins (CORS) ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://app.erp-scolaire.ma

# ─── JWT Public Key (RS256) ──────────────────────────────
# Exporter depuis Keycloak : Realm Settings > Keys > RS256 > Public Key
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...votre_cle_publique...\n-----END PUBLIC KEY-----

# ─── Anthropic (OostudyBot chatbot) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ─── Runtime ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
