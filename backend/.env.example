# Copier en .env et renseigner. Ne jamais committer .env.

# Serveur
PORT=3001

# OpenAI (obligatoire)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Authentification : secret partagé avec Moodle pour signer les JWT (HS256)
# Générer avec : openssl rand -base64 32
JWT_SECRET=

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_WHITELIST=https://iaoosted.oostudy.ma,https://moodle.oostudy.ma

# Supabase (optionnel ; sans ces variables les messages restent en mémoire)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Rate limit sur /api (défauts : 100 requêtes / 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
