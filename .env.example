# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL publique (liens de confirmation e-mail). Optionnel sur Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifications push de l'appli mobile (serveur uniquement, jamais NEXT_PUBLIC_) ---
# Compte de service Firebase (Paramètres du projet → Comptes de service)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Supabase → Project Settings → API Keys → clé secrète
SUPABASE_SECRET_KEY=
